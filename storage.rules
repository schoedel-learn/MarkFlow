rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSameObjectWrite() {
      return resource != null
        && request.resource != null
        && request.resource.size == resource.size
        && request.resource.md5Hash == resource.md5Hash
        && request.resource.contentType == resource.contentType
        && request.resource.metadata == resource.metadata;
    }

    function isZeroBytePlaceholderCreate(fileName) {
      return resource == null
        && request.resource != null
        && fileName == '_placeholder'
        && request.resource.size == 0;
    }

    match /pdf-inputs/{userId}/{jobId}/{fileName} {
      allow read: if isOwner(userId)
        && fileName == 'source.pdf';
      allow write: if isOwner(userId)
        && fileName == 'source.pdf'
        && (resource == null || isSameObjectWrite());
    }

    match /markdown-outputs/{userId}/{jobId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && (isZeroBytePlaceholderCreate(fileName) || isSameObjectWrite());
    }
  }
}