rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function hasOnlyJobCreateFields() {
      return request.resource.data.keys().hasOnly([
        'userId',
        'userEmail',
        'source',
        'status',
        'mode',
        'originalFilename',
        'sizeBytes',
        'pageCount',
        'inputKind',
        'storageInputPath',
        'createdAt',
        'updatedAt',
        'expiresAt'
      ]);
    }
    function hasAuthenticatedEmail() {
      return request.auth.token.email != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }
    function hasBoundedJobCreateTimestamps() {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
    }
    function hasValidJobStorageInputPath(jobId) {
      return request.resource.data.storageInputPath is string
        && request.resource.data.storageInputPath
          == 'pdf-inputs/' + request.auth.uid + '/' + jobId + '/source.pdf';
    }
    function hasNoJobStorageInputPath() {
      return !request.resource.data.keys().hasAny(['storageInputPath']);
    }
    function hasBackgroundJobCreateTimestamps() {
      return hasBoundedJobCreateTimestamps()
        && request.resource.data.expiresAt == request.time + duration.value(30, 'd');
    }
    function hasValidJobCreateBaseFields() {
      return hasOnlyJobCreateFields()
        && request.resource.data.userId == request.auth.uid
        && hasAuthenticatedEmail()
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.status == 'queued'
        && request.resource.data.source in ['approved_server', 'public_byok']
        && request.resource.data.mode in ['sync', 'background']
        && request.resource.data.originalFilename is string
        && request.resource.data.originalFilename.size() > 0
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount > 0
        && request.resource.data.inputKind == 'pdf';
    }
    function isValidApprovedServerBackgroundJobCreate(jobId) {
      return hasValidJobCreateBaseFields()
        && request.resource.data.source == 'approved_server'
        && request.resource.data.mode == 'background'
        && hasValidJobStorageInputPath(jobId)
        && hasBackgroundJobCreateTimestamps();
    }
    function isValidApprovedServerSyncJobCreate() {
      return hasValidJobCreateBaseFields()
        && request.resource.data.source == 'approved_server'
        && request.resource.data.mode == 'sync'
        && hasNoJobStorageInputPath()
        && hasBoundedJobCreateTimestamps();
    }
    function isValidPublicByokSyncJobCreate() {
      return hasValidJobCreateBaseFields()
        && request.resource.data.source == 'public_byok'
        && request.resource.data.mode == 'sync'
        && hasNoJobStorageInputPath()
        && hasBoundedJobCreateTimestamps();
    }
    function isValidJobCreate(jobId) {
      return isValidApprovedServerBackgroundJobCreate(jobId)
        || isValidApprovedServerSyncJobCreate()
        || isValidPublicByokSyncJobCreate();
    }
    function isOwnerJobUpdate() {
      return resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if false; // Users cannot delete their profiles directly
    }
    match /approved_users/{emailKey} {
      allow read: if isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == emailKey;
      allow create, update, delete: if false;
    }
    match /conversion_jobs/{jobId} {
      allow create: if isAuthenticated()
        && isValidJobCreate(jobId);
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && isOwnerJobUpdate();
      allow delete: if false;
    }
    match /conversion_errors/{errorId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }
    match /bug_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }
    match /stats/{statId} {
      allow create, update: if isAuthenticated();
      allow read, delete: if false;
    }
  }
}
